# ==============================================================================
# QWEN-999B Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# IMPORTANT: NEVER commit '.env' with real secrets to GitHub!
# The '.env' file is strictly excluded in '.gitignore'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Key
# ------------------------------------------------------------------------------
# Required for: data/scripts/generate_reasoning_data.py
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Hugging Face Authentication Token
# ------------------------------------------------------------------------------
# Required for:
#   - data/scripts/build_master_dataset.py (pushing dataset to Hugging Face)
#   - training/02_train_core_t4.ipynb (pulling private dataset & syncing checkpoints)
# Create a token with 'WRITE' permissions at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_write_token_here

# ------------------------------------------------------------------------------
# 3. Hugging Face Dataset Repository
# ------------------------------------------------------------------------------
# Format: <username>/<dataset-repo-name>
# Example: username/qwen-999b-reasoning-sft
# build_master_dataset.py will push the cleaned ChatML dataset to this repo.
HF_DATASET_REPO=your_username/qwen-999b-reasoning-sft

# ------------------------------------------------------------------------------
# 4. Optional Configurations
# ------------------------------------------------------------------------------
# Local Ollama endpoint for eval/run_benchmark.py
OLLAMA_HOST=http://localhost:11434
